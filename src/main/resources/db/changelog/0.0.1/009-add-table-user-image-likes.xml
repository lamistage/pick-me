<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="nica" id="9">
        <createTable tableName="user_image_likes">
            <column name="user_id" type="INTEGER"> <constraints nullable="false"/> </column>
            <column name="image_id" type="INTEGER"> <constraints nullable="false"/> </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_image_likes" baseColumnNames="user_id" constraintName="fk_user_image_likes_user" referencedTableName="app_user" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="user_image_likes" baseColumnNames="image_id" constraintName="fk_user_image_likes_image" referencedTableName="image" referencedColumnNames="id" onDelete="CASCADE"/>
        <addPrimaryKey tableName="user_image_likes" columnNames="user_id, image_id" constraintName="pk_user_image_likes" />
    </changeSet>
</databaseChangeLog>